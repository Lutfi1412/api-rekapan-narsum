          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin",
              "host": ["{{baseUrl}}"],
              "path": ["admin"]
            },
            "description": "Test negatif: tanpa Authorization harus 401."
          }
        },
        {
          "name": "POST /create - satu data",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('inserted = 1', () => pm.expect(body.inserted).to.eql(1));",
                  "if (body.data && body.data.length) pm.collectionVariables.set('id', body.data[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"Nama\": \"Mundhi Saptono Widigdo\",\n  \"Instansi\": \"Kepala Bagian Keuangan Direktorat Jenderal Perhubungan Laut, Kementerian Perhubungan\",\n  \"Topik\": \"Knowledge Sharing Tata Kelola Penghapusan Barang Milik Negara\",\n  \"Tanggal Mulai\": \"8 January 2026\",\n  \"Tanggal Selesai\": \"10 January 2026\",\n  \"Lokasi\": \"Grand Mercure Jakarta Kemayoran, Jl. H. Benyamin Sueb Kav. B6, Kemayoran\",\n  \"Mode Pelaksanaan\": \"Offline\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/create",
              "host": ["{{baseUrl}}"],
              "path": ["create"]
            },
            "description": "Menambah satu data. Kombinasi Nama + Topik + Tanggal Mulai yang sama akan ditolak 409."
          }
        },
        {
          "name": "POST /create - bulk 3 data (3 worker)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201 / 207 / 409', () => pm.expect([201, 207, 409]).to.include(pm.response.code));",
                  "const body = pm.response.json();",
                  "pm.test('workers = 3', () => pm.expect(body.workers).to.eql(3));",
                  "pm.test('total = 3', () => pm.expect(body.total).to.eql(3));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"Nama\": \"Suratno\",\n    \"Instansi\": \"Kepala Pusat Pendidikan dan Pelatihan Keuangan Publik (Pusdiklat KP)\",\n    \"Topik\": \"Pelatihan Jarak Jauh (PJJ) Aplikasi SIMAN Pengelola Barang (RKBMN)\",\n    \"Tanggal Mulai\": \"4 March 2026\",\n    \"Tanggal Selesai\": \"5 March 2026\",\n    \"Lokasi\": \"Daring\",\n    \"Mode Pelaksanaan\": \"Online\"\n  },\n  {\n    \"Nama\": \"Suratno\",\n    \"Instansi\": \"Kepala Pusat Pendidikan dan Pelatihan Keuangan Publik (Pusdiklat KP)\",\n    \"Topik\": \"Pelatihan Jarak Jauh (PJJ) Aplikasi SIMAN Pengelola Barang (BMN Idle dan Asuransi)\",\n    \"Tanggal Mulai\": \"5 March 2026\",\n    \"Tanggal Selesai\": \"6 March 2026\",\n    \"Lokasi\": \"Daring\",\n    \"Mode Pelaksanaan\": \"Online\"\n  },\n  {\n    \"Nama\": \"Nurrahman Toyib\",\n    \"Instansi\": \"Kepala Pusat Pendidikan dan Pelatihan Keuangan Publik (Pusdiklat KP)\",\n    \"Topik\": \"Pelatihan Jarak Jauh (PJJ) Aplikasi SIMAN Pengelola Barang (BMN Idle dan Asuransi)\",\n    \"Tanggal Mulai\": \"5 March 2026\",\n    \"Tanggal Selesai\": \"6 March 2026\",\n    \"Lokasi\": \"Daring\",\n    \"Mode Pelaksanaan\": \"Online\"\n  }\n]",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/create",
              "host": ["{{baseUrl}}"],
              "path": ["create"]
            },
            "description": "Bulk insert: array diproses paralel oleh 3 worker (env INSERT_WORKERS). Response memuat inserted, failed, workers, dan errors per item."
          }
        },
